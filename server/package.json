{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node ./dist/server.js",
    "start:prod": "NODE_ENV=production node ./dist/server.js",
    "dev": "nodemon",
    "build": "prisma generate",
    "vercel-build": "npm run build:vercel",
    "build:vercel": "node check-env.js && echo 'Building for Vercel...' && npx prisma generate && npx tsc -p tsconfig.json",
    "build:clean": "rm -rf dist && tsc",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "ts-node --esm prisma/seed.ts",
    "seed:prod": "tsc prisma/seed.ts --outDir dist/prisma --module nodenext --moduleResolution nodenext --target ES2022 && node dist/prisma/seed.js",
    "prisma:reset": "npm run prisma:clean && npm run generate && npm run migrate:reset",
    "prisma:clean": "rm -rf node_modules/.prisma node_modules/@prisma/client",
    "prisma:fix": "taskkill //F //IM node.exe 2>nul || true && npm run prisma:clean && npm run generate",
    "db:reset": "prisma migrate reset --force && npm run seed",
    "db:push": "prisma db push && npm run seed"
  },
  "prisma": {
    "seed": "ts-node --esm prisma/seed.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cloudinary": "^1.34.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "prisma": "^5.22.0",
    "yup": "^1.7.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/yup": "^0.29.14",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2"
  }
}
